<!DOCTYPE html><html lang="pt-BR" xmlns="http://www.w3.org/1999/xhtml">  <head>    <meta charset="UTF-8" />    <meta name="viewport" content="width=device-width, initial-scale=1.0" />    <meta http-equiv="X-UA-Compatible" content="IE=edge" />    <title>      Bem-vindo — Confirme sua conta    </title>    <style>      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=DM+Sans:wght@300;400;500&display=swap');            /* ─── Reset ─────────────────────────────────────── */            *,      *::before,      *::after {        box-sizing: border-box;        margin: 0;        padding: 0;      }            body,      table,      td,      a {        -webkit-text-size-adjust: 100%;        -ms-text-size-adjust: 100%;      }            table,      td {        mso-table-lspace: 0;        mso-table-rspace: 0;      }            img {        border: 0;        height: auto;        line-height: 100%;        outline: none;        text-decoration: none;        -ms-interpolation-mode: bicubic;      }            a {        text-decoration: none;      }            /* ─── Variables ──────────────────────────────────── */            :root {        --claret: #562C2C;        --sage: #4E6E5D;        --sand: #F5DFBB;        --sand-light: #FBF2E3;        --claret-dark: #3D1F1F;        --sage-light: #6A9480;        --text-dark: #2A1A1A;        --text-muted: #7A6A5A;      }            /* ─── Base ───────────────────────────────────────── */            body {        background-color: #EDE4D4;        font-family: 'DM Sans', Helvetica, Arial, sans-serif;        font-weight: 300;        color: var(--text-dark);      }            .email-wrapper {        width: 100%;        background-color: #EDE4D4;        background-image: radial-gradient(ellipse at 0% 0%, rgba(78,110,93,0.12) 0%, transparent 55%),                radial-gradient(ellipse at 100% 100%, rgba(86,44,44,0.10) 0%, transparent 55%);        padding: 40px 16px;      }            /* ─── Container ──────────────────────────────────── */            .email-container {        max-width: 560px;        margin: 0 auto;        border-radius: 4px;        overflow: hidden;        box-shadow: 0 2px 8px rgba(86,44,44,0.08), 0 24px 64px rgba(86,44,44,0.12);      }            /* ─── Header Band ────────────────────────────────── */            .header-band {        background-color: var(--claret);        height: 6px;      }            /* ─── Logo Area ──────────────────────────────────── */            .logo-area {        background-color: #FFFFFF;        padding: 32px 48px 24px;        text-align: center;        border-bottom: 1px solid rgba(245,223,187,0.5);      }            .logo-placeholder {        display: inline-block;        width: 120px;        height: 48px;        background-color: var(--sand);        border-radius: 2px;        line-height: 48px;        font-family: 'Cormorant Garamond', Georgia, serif;        font-size: 11px;        font-weight: 400;        letter-spacing: 0.2em;        text-transform: uppercase;        color: var(--text-muted);      }            /* ─── Hero ───────────────────────────────────────── */            .hero {        background-color: #FFFFFF;        padding: 48px 48px 32px;        text-align: center;        position: relative;      }            .hero::before {        content: '';        display: block;        width: 40px;        height: 2px;        background: linear-gradient(90deg, var(--claret), var(--sage));        margin: 0 auto 24px;      }            .welcome-badge {        display: inline-block;        background-color: var(--sand);        color: var(--claret);        font-family: 'DM Sans', Helvetica, Arial, sans-serif;        font-size: 10px;        font-weight: 500;        letter-spacing: 0.18em;        text-transform: uppercase;        padding: 6px 16px;        border-radius: 2px;        margin-bottom: 20px;      }            .hero-headline {        font-family: 'Cormorant Garamond', Georgia, serif;        font-size: 38px;        font-weight: 300;        line-height: 1.15;        color: var(--claret);        letter-spacing: -0.01em;        margin-bottom: 16px;      }            .hero-sub {        font-size: 14px;        font-weight: 300;        color: var(--text-muted);        line-height: 1.7;        max-width: 380px;        margin: 0 auto;      }            /* ─── CTA Section ────────────────────────────────── */            .cta-section {        background-color: #FFFFFF;        padding: 32px 48px 36px;        text-align: center;      }            /* ─── Código de Verificação ──────────────────────── */            .code-container {        position: relative;        margin: 0 auto 6px;        max-width: 380px;        border-radius: 12px;        padding: 2px;        background: linear-gradient(135deg, var(--claret) 0%, #8B4A4A 40%, var(--sage) 100%);        box-shadow: 0 8px 32px rgba(86,44,44,0.28),                0 2px 8px rgba(86,44,44,0.14),                inset 0 1px 0 rgba(255,255,255,0.1);      }            .code-inner {        background: linear-gradient(160deg, #1C0F0F 0%, #2A1A1A 50%, #0F1C14 100%);        border-radius: 10px;        padding: 32px 24px 28px;        position: relative;        overflow: hidden;      }            /* Efeito de brilho sutil no fundo */            .code-inner::before {        content: '';        position: absolute;        top: -40%;        left: -10%;        width: 55%;        height: 160%;        background: radial-gradient(ellipse, rgba(86,44,44,0.22) 0%, transparent 70%);        pointer-events: none;      }            .code-inner::after {        content: '';        position: absolute;        bottom: -40%;        right: -10%;        width: 55%;        height: 160%;        background: radial-gradient(ellipse, rgba(78,110,93,0.18) 0%, transparent 70%);        pointer-events: none;      }            .code-eyebrow {        font-size: 9px;        font-weight: 500;        letter-spacing: 0.22em;        text-transform: uppercase;        color: rgba(245,223,187,0.5);        display: block;        margin-bottom: 18px;        position: relative;        z-index: 1;      }            .code-plain {        font-family: 'Courier New', 'Courier', monospace;        font-size: 40px;        font-weight: 700;        color: #F5DFBB;        letter-spacing: 0.3em;        text-shadow: 0 0 20px rgba(245,223,187,0.5),                0 0 40px rgba(245,223,187,0.2);        position: relative;        z-index: 1;        display: block;        text-align: center;        width: 100%;        user-select: all;        cursor: text;      }            .code-shimmer-line {        width: 100%;        height: 1px;        background: linear-gradient(90deg, transparent, rgba(245,223,187,0.18), transparent);        margin: 18px 0 0;        position: relative;        z-index: 1;      }            .cta-note {        font-size: 11px;        color: #B0A090;        margin-top: 18px;        letter-spacing: 0.02em;        line-height: 1.6;      }            /* ─── Info Strip ─────────────────────────────────── */            .info-strip {        background-color: var(--sand-light);        border-top: 1px solid rgba(245,223,187,0.8);        border-bottom: 1px solid rgba(245,223,187,0.8);        padding: 20px 48px;        display: flex;        gap: 0;      }            .info-item {        flex: 1;        text-align: center;        padding: 0 12px;        border-right: 1px solid rgba(195,175,150,0.4);      }            .info-item:last-child {        border-right: none;      }            .info-label {        font-size: 9px;        font-weight: 500;        letter-spacing: 0.16em;        text-transform: uppercase;        color: var(--sage);        display: block;        margin-bottom: 4px;      }            .info-value {        font-family: 'Cormorant Garamond', Georgia, serif;        font-size: 15px;        color: var(--claret);      }            /* ─── Footer ─────────────────────────────────────── */            .footer {        background-color: var(--claret);        padding: 32px 48px;        text-align: center;      }            .footer-logo-placeholder {        display: inline-block;        width: 80px;        height: 32px;        border: 1px solid rgba(245,223,187,0.3);        border-radius: 2px;        line-height: 30px;        font-family: 'Cormorant Garamond', Georgia, serif;        font-size: 9px;        letter-spacing: 0.2em;        text-transform: uppercase;        color: rgba(245,223,187,0.5);        margin-bottom: 20px;      }            .footer-text {        font-size: 11px;        font-weight: 300;        color: rgba(245,223,187,0.65);        line-height: 1.8;        letter-spacing: 0.03em;      }            .footer-text a {        color: var(--sand);        text-decoration: underline;        text-underline-offset: 2px;      }            .footer-rule {        width: 32px;        height: 1px;        background-color: rgba(245,223,187,0.25);        margin: 20px auto;      }            /* ─── Bottom Band ────────────────────────────────── */            .bottom-band {        background-color: var(--claret-dark);        height: 4px;      }            /* ─── Responsive ─────────────────────────────────── */            @media only screen and (max-width: 600px) {        .email-wrapper {          padding: 0 !important;        }              .email-container {          border-radius: 0 !important;        }              .logo-area,        .hero,        .cta-section {          padding-left: 28px !important;          padding-right: 28px !important;        }              .hero-headline {          font-size: 30px !important;        }              .info-strip {          padding: 16px 28px !important;          flex-direction: column !important;          gap: 14px !important;        }              .info-item {          border-right: none !important;          border-bottom: 1px solid rgba(195,175,150,0.3) !important;          padding: 0 0 14px !important;        }              .info-item:last-child {          border-bottom: none !important;          padding-bottom: 0 !important;        }              .footer {          padding-left: 28px !important;          padding-right: 28px !important;        }              .code-plain {          font-size: 30px !important;          letter-spacing: 0.22em !important;        }      }            @media only screen and (max-width: 380px) {        .hero-headline {          font-size: 26px !important;        }              .cta-section {          padding: 24px 20px !important;        }      }    </style>  </head>  <body>    <div class="email-wrapper">      <div class="email-container">        {{-- ── Faixa superior ── --}}        <div class="header-band">        </div>        {{-- ── Logo ── --}}        <div class="logo-area">          {{-- Substitua o elemento abaixo pela sua tag <img> --}}          <img src="{{ photo }}" alt="Logo" />        </div>        {{-- ── Hero ── --}}        <div class="hero">          <span class="welcome-badge">Bem-vindo</span>          <h1 class="hero-headline">            Você está quase<br />lá, {{ name ?? 'amigo' }}.          </h1>          <p class="hero-sub">            Só mais um passo — confirme seu e-mail para ativar sua conta            e acessar tudo que preparamos para você.          </p>        </div>        {{-- ── Seção do Código ── --}}        <div class="cta-section">          <div class="code-container">            <div class="code-inner">              <span class="code-eyebrow">Seu código de verificação</span>              <span class="code-plain">{{ code }}</span>              <div class="code-shimmer-line">              </div>            </div>          </div>          <p class="cta-note">            Código válido por 30 minutos &nbsp;·&nbsp; Verifique a pasta de spam          </p>        </div>        {{-- ── Faixa de data / hora ── --}}        <div class="info-strip">          <div class="info-item">            <span class="info-label">Data</span>            <span class="info-value">{{ date ?? '1 de Janeiro de 2025' }}</span>          </div>          <div class="info-item">            <span class="info-label">Horário</span>            <span class="info-value">{{ time ?? '00:00 UTC' }}</span>          </div>          <div class="info-item">            <span class="info-label">Fuso Horário</span>            <span class="info-value">{{ timezone ?? 'UTC' }}</span>          </div>        </div>        {{-- ── Rodapé ── --}}        <div class="footer">          {{-- Substitua o elemento abaixo pela sua <img> de rodapé --}}          <div class="footer-logo-placeholder">            Logo          </div>          <p class="footer-text">            Você recebeu este e-mail porque uma conta foi cadastrada<br />            com este endereço em <strong style="color:var(--sand);font-weight:400;">{{ appName ?? 'Nossa Plataforma' }}</strong>.          </p>          <div class="footer-rule">          </div>          <p class="footer-text">            Não solicitou isso?            <a href="{{ ignoreUrl ?? '#' }}">Ignore este e-mail</a>            &nbsp;ou&nbsp;            <a href="{{ unsubscribeUrl ?? '#' }}">descadastre-se</a>.<br />            &copy; {{ year ?? '2025' }} {{ appName ?? 'Nossa Plataforma' }}. Todos os direitos reservados.          </p>        </div>        {{-- ── Faixa inferior ── --}}        <div class="bottom-band">        </div>      </div>    </div>  </body></html>