<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Welcome — Confirm Your Account</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=DM+Sans:wght@300;400;500&display=swap');

    /* ─── Reset ─────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0; mso-table-rspace: 0; }
    img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
    a { text-decoration: none; }

    /* ─── Variables ──────────────────────────────────── */
    :root {
      --claret:    #562C2C;
      --sage:      #4E6E5D;
      --sand:      #F5DFBB;
      --sand-light:#FBF2E3;
      --claret-dark:#3D1F1F;
      --sage-light: #6A9480;
      --text-dark:  #2A1A1A;
      --text-muted: #7A6A5A;
    }

    /* ─── Base ───────────────────────────────────────── */
    body {
      background-color: #EDE4D4;
      font-family: 'DM Sans', Helvetica, Arial, sans-serif;
      font-weight: 300;
      color: var(--text-dark);
    }

    .email-wrapper {
      width: 100%;
      background-color: #EDE4D4;
      background-image:
        radial-gradient(ellipse at 0% 0%, rgba(78,110,93,0.12) 0%, transparent 55%),
        radial-gradient(ellipse at 100% 100%, rgba(86,44,44,0.10) 0%, transparent 55%);
      padding: 40px 16px;
    }

    /* ─── Container ──────────────────────────────────── */
    .email-container {
      max-width: 560px;
      margin: 0 auto;
      border-radius: 4px;
      overflow: hidden;
      box-shadow:
        0 2px 8px rgba(86,44,44,0.08),
        0 24px 64px rgba(86,44,44,0.12);
    }

    /* ─── Header Band ────────────────────────────────── */
    .header-band {
      background-color: var(--claret);
      height: 6px;
    }

    /* ─── Logo Area ──────────────────────────────────── */
    .logo-area {
      background-color: #FFFFFF;
      padding: 32px 48px 24px;
      text-align: center;
      border-bottom: 1px solid rgba(245,223,187,0.5);
    }

    .logo-placeholder {
      display: inline-block;
      width: 120px;
      height: 48px;
      background-color: var(--sand);
      border-radius: 2px;
      line-height: 48px;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    /* ─── Hero ───────────────────────────────────────── */
    .hero {
      background-color: #FFFFFF;
      padding: 48px 48px 32px;
      text-align: center;
      position: relative;
    }

    .hero::before {
      content: '';
      display: block;
      width: 40px;
      height: 2px;
      background: linear-gradient(90deg, var(--claret), var(--sage));
      margin: 0 auto 24px;
    }

    .welcome-badge {
      display: inline-block;
      background-color: var(--sand);
      color: var(--claret);
      font-family: 'DM Sans', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 2px;
      margin-bottom: 20px;
    }

    .hero-headline {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 38px;
      font-weight: 300;
      line-height: 1.15;
      color: var(--claret);
      letter-spacing: -0.01em;
      margin-bottom: 16px;
    }

    .hero-sub {
      font-size: 14px;
      font-weight: 300;
      color: var(--text-muted);
      line-height: 1.7;
      max-width: 380px;
      margin: 0 auto;
    }

    /* ─── CTA Section ────────────────────────────────── */
    .cta-section {
      background-color: #FFFFFF;
      padding: 40px 48px 48px;
      text-align: center;
    }

    .cta-wrapper {
      text-align: center;
    }

    .cta-button {
    display: inline-flex;
      align-items: center;
      gap: 12px;
      background: linear-gradient(135deg, #3D1F1F 0%, #562C2C 100%);
      color: #F5DFBB !important;
      font-family: 'DM Sans', Helvetica, Arial, sans-serif;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 16px 36px;
      border-radius: 3px;
      border: 1px solid rgba(245,223,187,0.2);
      cursor: pointer;
      box-shadow: 0 4px 24px rgba(61,31,31,0.45), inset 0 1px 0 rgba(245,223,187,0.08);
      transition: all 0.2s ease;
    }

    .cta-button:hover {
      background: linear-gradient(135deg, #3D5E4C 0%, var(--sage) 100%);
      box-shadow: 0 6px 28px rgba(78,110,93,0.40);
      transform: translateY(-1px);
    }

    .cta-note {
      font-size: 11px;
      color: #B0A090;
      margin-top: 14px;
      letter-spacing: 0.02em;
    }

    /* ─── Info Strip ─────────────────────────────────── */
    .info-strip {
      background-color: var(--sand-light);
      border-top: 1px solid rgba(245,223,187,0.8);
      border-bottom: 1px solid rgba(245,223,187,0.8);
      padding: 20px 48px;
      display: flex;
      gap: 0;
    }

    .info-item {
      flex: 1;
      text-align: center;
      padding: 0 12px;
      border-right: 1px solid rgba(195,175,150,0.4);
    }

    .info-item:last-child {
      border-right: none;
    }

    .info-label {
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--sage);
      display: block;
      margin-bottom: 4px;
    }

    .info-value {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 15px;
      color: var(--claret);
    }

    /* ─── Footer ─────────────────────────────────────── */
    .footer {
      background-color: var(--claret);
      padding: 32px 48px;
      text-align: center;
    }

    .footer-logo-placeholder {
      display: inline-block;
      width: 80px;
      height: 32px;
      border: 1px solid rgba(245,223,187,0.3);
      border-radius: 2px;
      line-height: 30px;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(245,223,187,0.5);
      margin-bottom: 20px;
    }

    .footer-text {
      font-size: 11px;
      font-weight: 300;
      color: rgba(245,223,187,0.65);
      line-height: 1.8;
      letter-spacing: 0.03em;
    }

    .footer-text a {
      color: var(--sand);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .footer-rule {
      width: 32px;
      height: 1px;
      background-color: rgba(245,223,187,0.25);
      margin: 20px auto;
    }

    /* ─── Bottom Band ────────────────────────────────── */
    .bottom-band {
      background-color: var(--claret-dark);
      height: 4px;
    }

    /* ─── Responsive ─────────────────────────────────── */
    @media only screen and (max-width: 600px) {
      .email-wrapper  { padding: 0 !important; }
      .email-container { border-radius: 0 !important; }

      .logo-area,
      .hero,
      .cta-section { padding-left: 28px !important; padding-right: 28px !important; }

      .hero-headline { font-size: 30px !important; }

      .info-strip {
        padding: 16px 28px !important;
        flex-direction: column !important;
        gap: 14px !important;
      }

      .info-item {
        border-right: none !important;
        border-bottom: 1px solid rgba(195,175,150,0.3) !important;
        padding: 0 0 14px !important;
      }

      .info-item:last-child { border-bottom: none !important; padding-bottom: 0 !important; }

      .footer { padding-left: 28px !important; padding-right: 28px !important; }

      .cta-button { width: 100% !important; display: block !important; }
    }

    @media only screen and (max-width: 380px) {
      .hero-headline { font-size: 26px !important; }
      .cta-section { padding: 28px 20px !important; }
    }
  </style>
</head>
<body>

<div class="email-wrapper">
  <div class="email-container">

    {{-- ── Top accent band ── --}}
    <div class="header-band"></div>

    {{-- ── Logo ── --}}
    <div class="logo-area">
      {{-- Replace the div below with your <img> tag --}}
      {{--  <div class="logo-placeholder">Your Logo</div>  --}}
      <img src="assets/medkit-logo.svg" alt="Logo" width="120" height="48" style="display:block;margin:0 auto 24px;" />
    </div>

    {{-- ── Hero ── --}}
    <div class="hero">
      <span class="welcome-badge">Welcome</span>
      <h1 class="hero-headline">You're almost<br>in, {{ name ?? 'friend' }}.</h1>
      <p class="hero-sub">
        One step left — confirm your email to activate your account
        and unlock everything waiting for you.
      </p>
    </div>

    {{-- ── CTA Section ── --}}
    <div class="cta-section">
      <div class="cta-wrapper">
        <a href="{{ confirmationUrl ?? '#' }}" class="cta-button">
          Confirm my account
        </a>
        <p class="cta-note">
          Link expires in 24 hours &nbsp;·&nbsp; Check your spam folder
        </p>
      </div>
    </div>

    {{-- ── Date / Time Info Strip ── --}}
    <div class="info-strip">
      <div class="info-item">
        <span class="info-label">Date</span>
        <span class="info-value">{{ date ?? 'January 1, 2025' }}</span>
      </div>
      <div class="info-item">
        <span class="info-label">Time</span>
        <span class="info-value">{{ time ?? '00:00 UTC' }}</span>
      </div>
      <div class="info-item">
        <span class="info-label">Timezone</span>
        <span class="info-value">{{ timezone ?? 'UTC' }}</span>
      </div>
    </div>

    {{-- ── Footer ── --}}
    <div class="footer">
      {{-- Replace the div below with your footer <img> logo --}}
      <div class="footer-logo-placeholder">Logo</div>

      <p class="footer-text">
        You received this email because an account was registered<br>
        using this address on <strong style="color:var(--sand);font-weight:400;">{{ appName ?? 'Our Platform' }}</strong>.
      </p>

      <div class="footer-rule"></div>

      <p class="footer-text">
        Didn't request this?
        <a href="{{ ignoreUrl ?? '#' }}">Ignore this email</a>
        &nbsp;or&nbsp;
        <a href="{{ unsubscribeUrl ?? '#' }}">unsubscribe</a>.<br>
        &copy; {{ year ?? '2025' }} {{ appName ?? 'Our Platform' }}. All rights reserved.
      </p>
    </div>

    {{-- ── Bottom accent band ── --}}
    <div class="bottom-band"></div>

  </div>
</div>

</body>
</html>
